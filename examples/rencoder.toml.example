# Rencoder user config (TOML).
#
# Dev-only reference. This file mirrors `DEFAULT_CONFIG_TOML` in
# `rencoder_lib/src/config/app.rs` -- the live config that gets written
# to `<app_dir>/rencoder.toml` on first run via auto-create.
#
# When modifying either side, keep them in sync. (Future work: make
# this the single source of truth via `include_str!` from app.rs.)

# Auto-generated on first run because no config file was found at the
# app-level location (binary dir; or $RENENCODER_CONFIG if set). Edit
# values below to customize behavior; the file is reloaded on each
# invocation.
#
# CLI flags (-i, -o, --config, passthrough args) override values here.
# Unknown keys are rejected so typos surface immediately.

[encode]
# Target format. One of: x264 | hevc | vp9 | av1. Default: av1.
format = "av1"

# Bitrate in Kbps (used when crf = 0). Ignored in CRF mode.
# Default: 5000.
bitrate = 5000

# CRF quality value (libsvtav1 scale, 0..=63). Aligns 1:1 with ffmpeg's
# `-crf N`. Sentinel `0` switches to bitrate mode (uses `bitrate` field).
# Default: 45 (libsvtav1 medium quality).
crf = 45

# Cap source FPS at canonical values (0, 24, 25, 30, 60). 0 disables.
# Default: 0.
max_fps = 30

# Enable NVIDIA hardware acceleration via NVENC. When enabled, the NVENC
# encoders this machine can actually run are detected by a capability probe
# (a 1-frame test encode); unavailable ones fall back to software encoding
# with a warning. The CLI's --nv / --no-nv overrides this setting.
# Default: false.
nv = false

# Extension filter for `encode -d DIR`. Empty list = all files.
extensions = ["mp4", "mov", "avi"]

# Optional: directory where encoded outputs land. Not wired yet (output
# paths are computed per-input); reserved for a future stage where
# batch output lands in a single project directory.
# output_dir = "encoded"

[encode.encoders]
# Per-format encoder overrides. Uncomment to use a different encoder
# than the built-in default (libsvtav1, libx264, libx265, libvpx-vp9).
# av1 = "libsvtav1"
# x264 = "libx264"
# hevc = "libx265"
# vp9 = "libvpx-vp9"

[analyze]
# Output format. One of: csv | table | text | json. Default: csv.
format = "csv"

# Parallel analysis via rayon. Default: true.
parallel = true

# Optional: write the analyze output to this path instead of stdout.
# The CLI `-o` flag overrides this per-run; `-` means stdout (default).
# output = "video_stats.csv"

[paths]
# Where each file lives (design doc §3.6). Every entry may be absolute
# (used as is) or relative (resolved against its base directory):
# application-level paths against the application directory, run-level
# paths against the operation directory -- the directory this run acts
# on (CLI: the target's directory; GUI: the selected working directory).
#
# Precedence: environment variable / CLI > this file > built-in default.
#
# Log directory -- relative to the application directory.
# log_dir = "log"
# Work-record directory -- relative to the application directory.
# records_dir = "data"
# Machine capability record -- relative to the application directory.
# capability_record = "nvenc-capability.json"
# Cancel request file -- relative to the operation directory.
# cancel_file = "cancel"
# Run capability check report -- relative to the operation directory.
# capability_report = "capabilities.json"

[log]
# How much the app says. One of: off | error | warn | info | debug | trace.
# Default: info.
#
# This is a RUNTIME setting: a release build logs exactly as much as a
# debug build when this says "debug". Set it to "debug" to see what the
# app is doing, then put it back.
level = "info"

# Roll the log file over to the next one when it grows past this size
# (bytes). Default: 10485760 (10 MB).
# max_bytes = 10485760

# Delete log files older than this many days. Default: 7.
# max_days = 7
